<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>

  <xacro:depthai_camera camera_name="oak"
                      camera_model="OAK-D"
                      base_frame="oak-d-base-frame"
                      parent="oak_mount"
                      cam_pos_x="0.0"
                      cam_pos_y="0.0"
                      cam_pos_z="0.0"
                      cam_roll="0.0"
                      cam_pitch="0.0"
                      cam_yaw="0.0"/>
</robot>
